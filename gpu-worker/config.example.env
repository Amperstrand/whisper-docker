# Whisper Transcription Service — configuration
# Copy this file to .env (project root) and fill in the values.
# There is only one .env file — at the project root.

# Required: URL of the deployed Cloudflare Worker
API_URL=https://your-domain.workers.dev

# Required: Bearer token for authenticating with the Worker
# Generate with: openssl rand -hex 32
# Rotate with: ./gpu-worker/run.sh --rotate-token
WORKER_TOKEN=

# Required: Cloudflare API token (used by run.sh --rotate-token)
CLOUDFLARE_API_TOKEN=

# Unique identifier for this worker (useful with multiple workers)
WORKER_ID=gpu-1

# Seconds between polling for new jobs
POLL_INTERVAL=5

# Maximum jobs to process simultaneously
MAX_CONCURRENT_JOBS=1

# Transcription mode: "docker" (uses main Dockerfile) or "direct" (in-process faster-whisper)
MODE=docker

# Whisper model name (used in direct mode)
WHISPER_MODEL=turbo

# HuggingFace token for gated models (required for speaker diarization)
# Get one at https://huggingface.co/settings/tokens
# Also accept the pyannote model license at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=
